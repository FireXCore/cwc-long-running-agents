{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/kill-switch.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": ".claude/hooks/steer.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/verify-gate.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/track-read.sh"
          }
        ]
      }
    ]
  }
}
